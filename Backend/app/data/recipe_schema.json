{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Indonesian Recipe Schema",
  "description": "Schema for validating Indonesian recipe data before Neo4j migration",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "shortDescription",
      "description",
      "image",
      "region",
      "difficulty",
      "cookingTimeMinutes",
      "servings",
      "estimatedCost",
      "isTraditional",
      "isNew",
      "ingredients",
      "cookingSteps"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier for the recipe",
        "pattern": "^[0-9]+$"
      },
      "name": {
        "type": "string",
        "description": "Recipe name",
        "minLength": 3,
        "maxLength": 200
      },
      "shortDescription": {
        "type": "string",
        "description": "Brief description of the recipe",
        "minLength": 10,
        "maxLength": 500
      },
      "description": {
        "type": "string",
        "description": "Detailed description of the recipe",
        "minLength": 10
      },
      "image": {
        "type": "string",
        "description": "URL or path to recipe image",
        "format": "uri-reference"
      },
      "region": {
        "type": "string",
        "description": "Region of origin",
        "minLength": 2
      },
      "difficulty": {
        "type": "string",
        "enum": ["Mudah", "Sedang", "Sulit"],
        "description": "Cooking difficulty level"
      },
      "cookingTimeMinutes": {
        "type": "integer",
        "description": "Total cooking time in minutes",
        "minimum": 1,
        "maximum": 1440
      },
      "servings": {
        "type": "integer",
        "description": "Number of servings",
        "minimum": 1,
        "maximum": 100
      },
      "estimatedCost": {
        "type": "number",
        "description": "Estimated cost in IDR",
        "minimum": 0
      },
      "isTraditional": {
        "type": "boolean",
        "description": "Whether this is a traditional recipe"
      },
      "isNew": {
        "type": "boolean",
        "description": "Whether this is a new/modern recipe"
      },
      "culturalStory": {
        "type": "object",
        "properties": {
          "shortStory": {
            "type": "string",
            "description": "Brief cultural story"
          },
          "fullStory": {
            "type": "string",
            "description": "Detailed cultural story"
          },
          "regionalVariations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["region", "province", "difference"],
              "properties": {
                "region": {
                  "type": "string"
                },
                "province": {
                  "type": "string"
                },
                "difference": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "budgetData": {
        "type": "object",
        "properties": {
          "offlineStores": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "address", "openingHours", "estimatedDistance", "location", "rincianBahan"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "address": {
                  "type": "string"
                },
                "openingHours": {
                  "type": "string"
                },
                "estimatedDistance": {
                  "type": "number",
                  "minimum": 0
                },
                "location": {
                  "type": "object",
                  "required": ["lat", "lng"],
                  "properties": {
                    "lat": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    "lng": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    }
                  }
                },
                "rincianBahan": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "quantity", "estimatedPrice"],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "quantity": {
                        "type": "object",
                        "required": ["unit"],
                        "properties": {
                          "value": {
                            "type": ["number", "null"]
                          },
                          "unit": {
                            "type": "string"
                          }
                        }
                      },
                      "estimatedPrice": {
                        "type": "number",
                        "minimum": 0
                      },
                      "note": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ingredients": {
        "type": "array",
        "minItems": 1,
        "description": "List of ingredient groups",
        "items": {
          "type": "object",
          "description": "Group of ingredients by category",
          "minProperties": 1,
          "patternProperties": {
            "^[a-zA-Z_]+$": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "quantity"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2
                  },
                  "quantity": {
                    "type": "object",
                    "required": ["unit"],
                    "properties": {
                      "value": {
                        "type": ["number", "null"],
                        "minimum": 0
                      },
                      "unit": {
                        "type": "string"
                      }
                    }
                  },
                  "notes": {
                    "type": "string"
                  },
                  "substitutes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "cookingSteps": {
        "type": "array",
        "minItems": 1,
        "description": "List of cooking steps",
        "items": {
          "type": "object",
          "required": ["step", "title", "description", "duration", "difficulty"],
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string",
              "minLength": 3
            },
            "description": {
              "type": "string",
              "minLength": 10
            },
            "duration": {
              "type": "string",
              "pattern": "^[0-9]+ (menit|jam)$"
            },
            "difficulty": {
              "type": "string",
              "enum": ["mudah", "sedang", "sulit"]
            },
            "image": {
              "type": "string"
            },
            "tips": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "additionalProperties": false
  }
}
